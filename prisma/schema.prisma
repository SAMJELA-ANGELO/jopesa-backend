// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== USER & AUTHENTICATION ====================

enum UserRole {
  ADMIN
  MEMBER
  ALUMNI
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole @default(ALUMNI)
  
  // Alumni specific fields
  alumniProfile      AlumniProfile?
  contributionPayments ContributionPayment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
}

// ==================== ALUMNI & BATCH ====================

model Batch {
  id        String   @id @default(cuid())
  year      Int      @unique
  name      String   @unique // e.g., "Batch 2020", "Class of 2020"
  season    String?  // e.g., "Spring", "Fall"
  
  alumni    AlumniProfile[]
  events    Event[]  @relation("EventBatches")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([year])
}

model AlumniProfile {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  
  // Alumni info
  batch        Batch    @relation(fields: [batchId], references: [id])
  batchId      String
  branch       Branch   @relation(fields: [branchId], references: [id])
  branchId     String
  
  bio          String?
  profileImage String?
  coverImage   String?
  relationshipStatus String?
  
  // Contact info
  linkedIn     String?
  twitter      String?
  instagram    String?
  website      String?
  
  // Additional info
  currentRole  String?
  currentCompany String?
  location     String?
  
  isVerified   Boolean  @default(false)
  
  // Relationships
  events         Event[] @relation("alumniAttended")
  registrations  EventRegistration[]
  posts          Post[]
  comments       Comment[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([batchId])
  @@index([branchId])
  @@index([isVerified])
}

model Branch {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Computer Science", "Civil Engineering"
  code        String   @unique // e.g., "CS", "CE"
  description String?
  
  alumni      AlumniProfile[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== EVENTS ====================

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventRegistrationStatus {
  PENDING
  APPROVED
  FLAGGED
  DECLINED
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  image       String?
  images      String[]    @default([])
  
  // Event details
  startDate   DateTime
  endDate     DateTime
  location    String
  batches     Batch[]     @relation("EventBatches")
  
  status      EventStatus @default(PUBLISHED)
  isVirtual   Boolean     @default(false)
  meetLink    String?
  
  // Registration form configuration
  registrationForm Json?   // Stores form field definitions
  
  // Attendance
  attendees     AlumniProfile[] @relation("alumniAttended")
  registrations EventRegistration[]
  photos        EventPhoto[]
  contributions Contribution[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([startDate])
  @@index([status])
}

model EventPhoto {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  url       String
  publicId  String?
  caption   String?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

model EventRegistration {
  id             String                  @id @default(cuid())
  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  alumni         AlumniProfile           @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  alumniId       String
  responses      Json                    // { fieldId: value }
  status         EventRegistrationStatus @default(PENDING)
  paidAmount     Float?
  paymentProofUrl String?
  paymentHistory Json?
  createdAt      DateTime                @default(now())

  @@unique([eventId, alumniId])
  @@index([eventId])
  @@index([alumniId])
}

// ==================== ANNOUNCEMENTS ====================

enum AnnouncementType {
  NEWS
  UPDATE
  EVENT
  OPPORTUNITY
  WARNING
}

model Announcement {
  id          String           @id @default(cuid())
  title       String
  content     String           @db.Text
  type        AnnouncementType @default(NEWS)
  image       String?
  
  isPinned    Boolean          @default(false)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedAt DateTime?
  
  @@index([type])
  @@index([isPinned])
  @@index([publishedAt])
}

// ==================== DOCUMENTS ====================

enum DocumentType {
  PDF
  IMAGE
  PRESENTATION
  SPREADSHEET
  VIDEO
  OTHER
}

model Document {
  id          String       @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    DocumentType
  fileSize    Int          // in bytes
  
  category    String       // e.g., "Academic", "Job Resources", "Guidelines"
  tags        String[]     @default([])
  
  downloads   Int          @default(0)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([category])
  @@index([tags])
}

// ==================== COMMUNITY / POSTS ====================

model Post {
  id          String   @id @default(cuid())
  content     String   @db.Text
  image       String?
  
  author      AlumniProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  
  comments    Comment[]
  likes       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  
  author    AlumniProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  
  likes     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([postId])
  @@index([authorId])
}

// ==================== PAYMENTS ====================

enum PaymentStatus {
  CREATED
  SUCCESSFUL
  FAILED
  EXPIRED
}

model Payment {
  id          String        @id @default(cuid())
  transId     String?       @unique
  amount      Int
  currency    String?       @default("XAF")
  status      PaymentStatus @default(CREATED)
  userId      String?       
  email       String?
  externalId  String?
  reason      String?
  metadata    Json?
  rawPayload  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Payments associated with contributions
  contributionPayments ContributionPayment[]

  @@index([userId])
  @@index([transId])
}

// ==================== CONTRIBUTIONS / COLLECTIONS ====================

enum ContributionType {
  EVENT_REGISTRATION
  ANNUAL_FEE
  GENERAL
  DONATION
  PROJECT
  OTHER
}

enum ContributionStatus {
  ACTIVE
  INACTIVE
}

enum ContributionPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Contribution {
  id           String               @id @default(cuid())
  title        String
  type         ContributionType     @default(GENERAL)
  description  String?
  status       ContributionStatus   @default(ACTIVE)
  installments Json?
  eventId      String?

  // Optional event link for registration-style contribution records
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Payments made to this contribution
  payments     ContributionPayment[]

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([eventId])
}

model ContributionPayment {
  id               String                    @id @default(cuid())
  contribution     Contribution              @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  contributionId   String
  payer            User?                     @relation(fields: [payerId], references: [id], onDelete: Cascade)
  payerId          String?
  payerName        String
  payerEmail       String
  amount           Float
  installmentLabel String?
  paymentDate      DateTime?
  status           ContributionPaymentStatus @default(PENDING)
  paymentReference String?
  notes            String?
  payment          Payment?                  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt

  @@index([contributionId])
  @@index([payerId])
  @@index([paymentId])
}
